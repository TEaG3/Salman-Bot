# Copy to .env locally. Never commit real credentials.
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
DATABASE_URL=postgresql://localhost/salman_bot_development
FRONTEND_ORIGIN=http://localhost:3000
RAILS_MAX_THREADS=5

# Required for protected automation and assistant API endpoints
SALMAN_API_TOKEN=replace-with-a-long-random-secret
# Required for AI workflow generation (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
